<?xml version="1.0" encoding="utf-8"?>
<!--
    Da Android 12 `allowBackup` non basta più: il backup su cloud e il trasferimento
    verso un nuovo telefono si configurano qui, separatamente. Senza questo file lo
    storico dei giri — che è una cronologia degli spostamenti — verrebbe copiato al
    cambio di dispositivo anche con `allowBackup="false"`.

    Si esclude tutto, non solo `rides.json`: nel file "bike" delle SharedPreferences c'è
    anche l'ultima posizione nota, che è lo stesso genere di dato.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
